# Contributor: Hevi Optronics
# Client-only build of community/netbird (aports 3.24-stable) from this checkout.
pkgname=netbird
pkgver=0.82.1_p1
pkgrel=0
# _nbver is the upstream release; netbird reports it as its version.
_nbver=${pkgver%_p*}
pkgdesc="WireGuard-based overlay network and mesh VPN"
url="https://netbird.io/"
arch="x86_64"
license="BSD-3-Clause"
options="net !check" # tests require root
depends="openresolv"
makedepends="git go"
subpackages="
$pkgname-doc
$pkgname-openrc
$pkgname-bash-completion
$pkgname-fish-completion
$pkgname-zsh-completion
"
install="$pkgname.pre-install"
source="
unix-socket-permissions.patch
netbird.initd
netbird.confd
"
# _srcroot is the repository checkout that holds this APKBUILD.
_srcroot="$startdir/../.."
builddir="$srcdir/$pkgname-$_nbver"

prepare() {
	mkdir -p "$builddir"
	# Build the committed tree at HEAD, so untracked and changed files stay out.
	git -C "$_srcroot" archive --format=tar HEAD | tar -C "$builddir" -xf -
	default_prepare
}

build() {
	mkdir -p build
	go build -v -o build \
		-ldflags "-X github.com/netbirdio/netbird/version.version=$_nbver -extldflags \"$LDFLAGS\"" \
		./client
}

package() {
	install -Dm0755 build/client "$pkgdir"/usr/bin/netbird
	install -Dm0644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE

	install -Dm0755 "$srcdir"/netbird.initd "$pkgdir"/etc/init.d/netbird
	install -Dm0644 "$srcdir"/netbird.confd "$pkgdir"/etc/conf.d/netbird

	local bashdir="$pkgdir"/usr/share/bash-completion/completions
	local fishdir="$pkgdir"/usr/share/fish/vendor_completions.d
	local zshdir="$pkgdir"/usr/share/zsh/site-functions
	mkdir -p "$bashdir" "$fishdir" "$zshdir"
	"$pkgdir"/usr/bin/netbird completion bash >"$bashdir"/netbird
	"$pkgdir"/usr/bin/netbird completion fish >"$fishdir"/netbird.fish
	"$pkgdir"/usr/bin/netbird completion zsh >"$zshdir"/_netbird
}

